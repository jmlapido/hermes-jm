# Copy to .env (chmod 600) and fill in. .env is never committed.
# Every HOMEPAGE_VAR_X below replaces {{HOMEPAGE_VAR_X}} in config/*.yaml.
# For a secret kept in a file instead, use HOMEPAGE_FILE_X=/path/to/file
# (mount the file into the container) and reference {{HOMEPAGE_FILE_X}}.

# ---- Container -------------------------------------------------------------
# Exact hostname that `tailscale serve` publishes (check `tailscale serve status`).
HOMEPAGE_ALLOWED_HOSTS=homepage.tailXXXXXX.ts.net
PUID=1000
PGID=1000

# ---- Proxmox VE (pve01) ----------------------------------------------------
# Dedicated READ-ONLY token (PVEAuditor) for Homepage. Never reuse hermes@pve!agent.
HOMEPAGE_VAR_PROXMOX_URL=https://192.168.1.10:8006
HOMEPAGE_VAR_PROXMOX_NODE=pve01
HOMEPAGE_VAR_PROXMOX_TOKEN_ID=hermes@pve!homepage
HOMEPAGE_VAR_PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- LibreNMS ---------------------------------------------------------------
# Read-only API token: LibreNMS -> Settings (gear) -> API -> API Settings -> Create
# (create it for a read-only/global-read user, not admin).
HOMEPAGE_VAR_LIBRENMS_URL=https://librenms.tailXXXXXX.ts.net
HOMEPAGE_VAR_LIBRENMS_KEY=changeme

# ---- Uptime Kuma ------------------------------------------------------------
HOMEPAGE_VAR_UPTIMEKUMA_URL=http://192.168.1.x:3001
HOMEPAGE_VAR_UPTIMEKUMA_SLUG=sites

# ---- Tailscale ----------------------------------------------------------------
# API access token: https://login.tailscale.com/admin/settings/keys (expires, max 90 days).
# Device ID: Machines -> hermes-aws -> Machine Details -> ID (ends in CNTRL).
HOMEPAGE_VAR_TAILSCALE_KEY=tskey-api-xxxxxxxxxxxx
HOMEPAGE_VAR_TAILSCALE_DEVICE_ID=xxxxxxxxxxxxCNTRL

# ---- Hermes (EC2, tailnet host hermes-aws) ------------------------------------
# Hermes API /health, published by dashboards/tailscale-serve.sh on :9443 (8642 stays on
# loopback). Reachable from this CT because tag:homepage is granted 9443 in the ACL.
HOMEPAGE_VAR_HERMES_HEALTH_URL=https://hermes-aws.tailXXXXXX.ts.net:9443/health
HOMEPAGE_VAR_HERMES_DASHBOARD_URL=https://hermes-aws.tailXXXXXX.ts.net:8443
HOMEPAGE_VAR_OPENWEBUI_URL=https://hermes-aws.tailXXXXXX.ts.net
