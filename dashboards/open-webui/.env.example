# Copy to .env (git-ignored, chmod 600). Never commit the real file.
#   cp .env.example .env && chmod 600 .env
#
# Fill it on the box from the values Hermes already has (no copy/paste of secrets):
#   key=$(sudo grep '^API_SERVER_KEY=' /home/hermes/.hermes/.env | cut -d= -f2-)
#   sed -i "s|^OPENAI_API_KEY=.*|OPENAI_API_KEY=$key|" .env
#   sed -i "s|^WEBUI_SECRET_KEY=.*|WEBUI_SECRET_KEY=$(openssl rand -hex 32)|" .env
#   ts=$(tailscale status --json | jq -r '.Self.DNSName' | sed 's/\.$//')
#   sed -i "s|hermes-aws\.TAILNET\.ts\.net|$ts|g" .env

# Must equal API_SERVER_KEY in ~/.hermes/.env (SSM /hermes/env/API_SERVER_KEY).
OPENAI_API_KEY=change-me

# Signs Open WebUI login sessions. Keep it stable or every restart logs you out.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me

# Public (tailnet) URL that tailscale serve publishes. Used for links and CORS.
WEBUI_URL=https://hermes-aws.TAILNET.ts.net
CORS_ALLOW_ORIGIN=https://hermes-aws.TAILNET.ts.net

# Optional: name shown in the browser tab / login page.
WEBUI_NAME=Hermes

# NOTE: OPENAI_*, ENABLE_SIGNUP, DEFAULT_USER_ROLE and most other settings are
# "PersistentConfig": they are read on first start only and then live in Open WebUI's
# database. Change them later in Admin Panel > Settings, not here.
